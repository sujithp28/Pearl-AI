{
  "name": "pearl-vscode",
  "displayName": "Pearl",
  "description": "Chat, autonomous execution, patch-preview approval, and repository-aware assistance from Pearl, a self-hostable AI coding agent.",
  "version": "1.2.0-beta.0",
  "publisher": "pearl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sujithp28/Pearl-AI.git"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pearl.openChat",
        "title": "Pearl: Open Chat"
      },
      {
        "command": "pearl.refreshMemory",
        "title": "Pearl: Refresh Memory",
        "icon": "$(refresh)"
      },
      {
        "command": "pearl.createCheckpoint",
        "title": "Pearl: Create Checkpoint",
        "icon": "$(save)"
      },
      {
        "command": "pearl.refreshCheckpoints",
        "title": "Pearl: Refresh Checkpoints",
        "icon": "$(refresh)"
      },
      {
        "command": "pearl.restoreCheckpoint",
        "title": "Pearl: Restore Checkpoint",
        "icon": "$(history)"
      },
      {
        "command": "pearl.deleteCheckpoint",
        "title": "Pearl: Delete Checkpoint",
        "icon": "$(trash)"
      },
      {
        "command": "pearl.renameCheckpoint",
        "title": "Pearl: Rename Checkpoint",
        "icon": "$(edit)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pearl",
          "title": "Pearl",
          "icon": "$(database)"
        }
      ]
    },
    "views": {
      "pearl": [
        {
          "id": "pearlMemory",
          "name": "Memory"
        },
        {
          "id": "pearlCheckpoints",
          "name": "Checkpoints"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "pearl.refreshMemory",
          "when": "view == pearlMemory",
          "group": "navigation"
        },
        {
          "command": "pearl.createCheckpoint",
          "when": "view == pearlCheckpoints",
          "group": "navigation"
        },
        {
          "command": "pearl.refreshCheckpoints",
          "when": "view == pearlCheckpoints",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "pearl.restoreCheckpoint",
          "when": "view == pearlCheckpoints && viewItem == pearlCheckpoint",
          "group": "inline@1"
        },
        {
          "command": "pearl.renameCheckpoint",
          "when": "view == pearlCheckpoints && viewItem == pearlCheckpoint",
          "group": "inline@2"
        },
        {
          "command": "pearl.deleteCheckpoint",
          "when": "view == pearlCheckpoints && viewItem == pearlCheckpoint",
          "group": "inline@3"
        }
      ]
    },
    "configuration": {
      "title": "Pearl",
      "properties": {
        "pearl.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to the Python interpreter used to run Pearl's MCP server (`<pythonPath> -m src.mcp`). Point this at the interpreter inside the Pearl repo's virtual environment if 'python3' does not have Pearl's dependencies installed."
        },
        "pearl.provider": {
          "type": "string",
          "default": "",
          "description": "Informational only: the LLM provider Pearl's MCP server is configured to use (e.g. claude, openai, ollama, custom), shown in the status bar. This mirrors your server-side PEARL_LLM_PROVIDER setting but is not read from the server itself — set it to match if you want it displayed."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "pretest": "npm run compile",
    "test": "node --test \"out/test/**/*.test.js\"",
    "package": "npm run compile && npx vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
