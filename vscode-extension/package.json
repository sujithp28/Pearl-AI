{
  "name": "pearl-vscode",
  "displayName": "Pearl",
  "description": "VS Code extension scaffold for Pearl, the AI coding agent.",
  "version": "0.0.1",
  "publisher": "pearl",
  "private": true,
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pearl.openChat",
        "title": "Pearl: Open Chat"
      }
    ],
    "configuration": {
      "title": "Pearl",
      "properties": {
        "pearl.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to the Python interpreter used to run Pearl's MCP server (`<pythonPath> -m src.mcp`). Point this at the interpreter inside the Pearl repo's virtual environment if 'python3' does not have Pearl's dependencies installed."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "pretest": "npm run compile",
    "test": "node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
