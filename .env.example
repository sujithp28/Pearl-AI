# Pearl — environment configuration
# Copy this file to .env and fill in the values that apply to you.
# Existing environment variables always take precedence over .env.

# ===========================================================
# Pearl Inference (default provider)
# ===========================================================
#
# Development path: use OpenRouter — a single key that routes
# to Claude, GPT, and 100+ other models via the OpenAI wire
# protocol. No extra SDK needed.
#
# Get a free key at: https://openrouter.ai/keys
#
PEARL_INFERENCE_API_KEY=

# Where Pearl's inference layer lives.
# Dev default: OpenRouter (set above)
# Future hosted Pearl gateway: https://api.pearl.ai/v1
PEARL_INFERENCE_BASE_URL=https://openrouter.ai/api/v1

# Model used for conversational replies (fast, cheap)
PEARL_INFERENCE_CHAT_MODEL=anthropic/claude-haiku-4-5-20251001

# Model used for planning (JSON-structured, needs accuracy)
PEARL_INFERENCE_PLAN_MODEL=anthropic/claude-sonnet-4-5-20251001

# ===========================================================
# BYOK — bring your own key (Advanced Settings in the UI)
# ===========================================================
# Set PEARL_LLM_PROVIDER to one of: openai, anthropic, openrouter,
# gemini, custom — then supply the matching key below.
# Leave PEARL_LLM_PROVIDER unset to use Pearl (above).

# PEARL_LLM_PROVIDER=openai

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/auto

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# CUSTOM_API_KEY=
# CUSTOM_BASE_URL=
# CUSTOM_MODEL=

# ===========================================================
# Optional tuning
# ===========================================================

# PEARL_CHAT_HISTORY_TURNS=10
# PEARL_SHELL_TIMEOUT=30
# PERSONALITY=cheeky
# EMOJI_MODE=minimal
